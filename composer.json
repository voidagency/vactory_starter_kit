          "reference": "3486194-d11_ready"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/improved_multi_select",
        "version": "1.8.0",
        "type": "drupal-module",
        "source": {
          "type": "git",
          "url": "https://git.drupalcode.org/issue/improved_multi_select-3451141.git",
          "reference": "3451141-d11_ready"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/views_url_alias",
        "version": "3.1.0",
        "type": "drupal-module",
        "source": {
          "type": "git",
