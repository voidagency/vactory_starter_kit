  "require-dev": {
    "squizlabs/php_codesniffer": "^3.3",
    "drupal/coder": "8.3.13",
    "brainmaestro/composer-git-hooks": "3.0.0-alpha.1"
  },
  "extra": {
    "hooks": {
      "pre-commit": [
        "source scripts/githooks/pre_commit.sh"
      ],
      "commit-msg": "source scripts/githooks/commit_message.sh",
      "post-merge": "source scripts/githooks/post_merge.sh",
      "pre-push": []
    },
    "php-composter-phpcs-drupal": {
      "standard": "DrupalPractice"
    },
    "php-composter-regular-expression": {
      "commit-message": {
        "subject": {
          "has": "^(Add|Fix|Change|Update|Documentation):|^Merged|^merged"
        }
      }
    },
    "enable-patching": true,
    "patches": {
      "drupal/simplify_menu": {
        "Add callable : filterLanguage": "https://gist.githubusercontent.com/ismail-void/73d5a8497bc09443ae5a6e7467609dd3/raw/adb696894af3b6fcbf5adab7c199432e839f8403/add-filterLanguage-callable.patch"
      },
      "drupal/features": {
        "Export config translation": "https://www.drupal.org/files/issues/features_export-config-translation-2869336-2.patch"
      },
      "drupal/social_auth_microsoft": {
        "Fixing call to function on null.": "https://gist.githubusercontent.com/voidagency/33e6445b2b0fe973654304a6ea04d50e/raw/80cd36664fe77ec6196bb310b49e8b7d27c8c96d/microsoft_social_auth.patch",
        "Update to v2 endpoints.": "https://gist.githubusercontent.com/voidagency/e45c99aff42a75a8925e043d4c22b670/raw/127ee70e123dc79d308042e519171c160a0b5ab0/social_auth_microsoft-v2.patch"
      },
      "stevenmaguire/oauth2-microsoft": {
        "Fix Bearer Authorization - Update ResourceOwner": "https://gist.githubusercontent.com/voidagency/b3b3508f2edb982b4f60a12517184e19/raw/08835c48e75e7f19f7396013988d934be30526ce/oauth2-microsoft-authorization-ressource-owner.patch"
      },
      "drupal/swiftmailer": {
        "Fix undefined index warnings on reset password form": "https://www.drupal.org/files/issues/2020-10-29/3179656-two-undentified-index-notices-2.patch",
        "Swiftmailer fix renderPlan method cli breaks": "https://gist.githubusercontent.com/voidagency/2d6230d4c481d5f80e8e9c8e783a2963/raw/8f7e40b7b90406b96865dde05b57a4ad8d854b68/swiftmailer-prevent-cli-commands-break.patch"
      },
      "drupal/jquery_colorpicker": {
        "jQuery color picker resolve vendor path": "https://gist.githubusercontent.com/voidagency/606f9343e9c7e9b99858088d7db111f1/raw/5216cc90d89e68916b4a17b60e07466286a18397/jquery-color-picker-resolve-vendor-path.patch",
        "jQuery color picker remove vendor dependencies": "https://gist.githubusercontent.com/voidagency/17af206778d4ea598b93dd10769556a0/raw/538e683f77b15945a41b99548a6b0d1ca2315225/jquery-colorpicker-remove-vendor-dependencies.patch",
        "jQuery color picker update background (drupalSettings variable)": "https://gist.githubusercontent.com/voidagency/94489fb9998406959ebefb31a758f39c/raw/6692adac21ef17ea4d66d69584159a6802707404/jquery-colorpicker-update-background.patch",
        "jQuery color picker default color": "https://gist.githubusercontent.com/voidagency/35c94c16af59f3eea64aa4d05805db15/raw/6dc9b83bbf9e0fa2df18ab2b3b0b6e460546cbe6/jquery_color_picker_default_color.patch"
      },
      "drupal/webform": {
        "Invoke alter hook after webform handlers execution": "https://gist.githubusercontent.com/voidagency/6871bd7544b621e2c4221126c5dfec50/raw/7595d19a34e18ab9f719b7f917c02b10a4a40caf/webform-post-handlers-hook.patch"
      },
      "drupal/captcha": {
        "Fix captcha error message translation": "https://gist.githubusercontent.com/voidagency/11480147ce444bf3b4b7c5539f213452/raw/5a2d3f39bc5f795bb25b5c91ab050ad8d9ad1837/fix-captcha-error-message-translation.patch"
      },
      "drupal/jsonapi_extra": {
        "Default field enhancer for fields": "https://gist.githubusercontent.com/voidagency/4861a0f0343a45cf0582553fc80c6b59/raw/2342d707c2b6708f2c18a69b870fcad1d5242df3/jsonapi_default_field_enhancer_for_fields.patch"
      },
      "voidagency/cloudinary": {
        "Cloudinary video media library compatibility fix": "https://gist.githubusercontent.com/voidagency/21729df75ca350faace0f7883960bc37/raw/88e6ce0980cb3e01c95f74e1c79b4baddcdf884e/cloudinary-video-media-library-compatibility-fix.patch"
      },
      "drupal/jsonapi_cross_bundles": {
        "Fix jsonapi cross bundles": "https://gist.githubusercontent.com/ismail-void/7e56262e60c81fbbd43874d37f145a6d/raw/95b5db1a582cdfe5c9ff987443b5ebc7f76e7766/fix-jsonapi-cross-bundles.patch"
      },
      "drupal/search_api_ai": {
        "Seach ai pinecone free account issue": "https://gist.githubusercontent.com/khalidbouhouch77/097184b7b3e611ff5e052902486601f3/raw/d7255c4f884aeb39eb68830d8cd77821eeee3634/search-api-pineconebackend-namespace-lang.patch",
        "Search api ai rector patch for drupal 11": "https://www.drupal.org/files/issues/2024-05-30/search_api_ai.1.0.x-dev.rector.patch"
      },
      "drupal/file_entity": {
        "Fix missing bundle entity, entity type file_type, entity id undefined": "https://gist.githubusercontent.com/voidagency/b2ec60b41a9ef234ba860c03c05410f4/raw/cea45bcd86a2063d7460a99d1757719035a75314/remove-undefined-bundle-from-entity-type-file-type.patch"
      }
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8",
