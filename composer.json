        "drupal/onesignal",
        "drupal/jquery_colorpicker",
        "drupal/easy_install",
        "drupal/amptheme",
        "drupal/improved_multi_select",
        "drupal/views_url_alias",
        "drupal/amp"
      ]
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/onesignal",
        "type": "drupal-module",
        "version": "dev-project-update-bot-only",
        "source": {
          "type": "git",
          "url": "https://git.drupalcode.org/issue/onesignal-3433682.git",
          "reference": "project-update-bot-only"
