<?php

/**
 * @file
 * Module install/uninstall related hooks.
 */

/**
 * Implements hook_install().
 */
function vactory_sondage_install($is_syncing) {
  // Add sodage consumer id to reminder settings.
  $config = \Drupal::configFactory()->getEditable('vactory_reminder.settings');
  $reminder_consumers = !empty($config->get('reminder_consumers')) ? $config->get('reminder_consumers') : [];
  $reminder_consumers_string = '';
  $reminder_consumers['vactory_sondage_closer'] = '1 min';
  foreach ($reminder_consumers as $key => $value) {
    $reminder_consumers_string .= !empty($reminder_consumers_string) ? PHP_EOL . $key . '|' . $value : $key . '|' . $value;
  }
  $config->set('reminder_consumers', $reminder_consumers)
    ->set('reminder_consumers_string', $reminder_consumers_string)
    ->save();
}

/**
 * Repairs the queued closings of sondages (Redmine #71443).
 *
 * The closings queued so far have no sondage ID and fail at every run of the
 * reminder queue: they are deleted. The closing of each open sondage whose
 * close date is still to come is queued again. An open sondage whose close
 * date has passed is left open.
 */
function vactory_sondage_update_10001() {
  $counts = \Drupal::service('vactory_sondage.closing_scheduler')->repairQueue();
  return t('Sondage closings: @removed broken items deleted, @scheduled open sondages scheduled, @past open sondages with a passed close date left open.', [
    '@removed' => $counts['removed'],
    '@scheduled' => $counts['scheduled'],
    '@past' => $counts['past'],
  ]);
}
