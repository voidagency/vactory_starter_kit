<?php

/**
 * @file
 * Install, update, and uninstall functions for the Social Auth Keycloak module.
 */

/**
 * Rename Keycloak client settings to the Social Auth 4.x keys.
 */
function vactory_keycloak_update_10001() {
  $config = \Drupal::configFactory()->getEditable('vactory_keycloak.settings');
  if ($config->isNew()) {
    return;
  }
  $renamed = [
    'app_client_id' => 'client_id',
    'app_client_secret' => 'client_secret',
  ];
  foreach ($renamed as $old => $new) {
    if ($config->get($old) !== NULL) {
      $config->set($new, $config->get($old))->clear($old);
    }
  }
  // Social Auth 4.x expects strings.
  foreach (['scopes', 'endpoints'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, '');
    }
  }
  $config->clear('oauth_redirect_url')
    ->clear('redirect_uri')
    ->save();
}
