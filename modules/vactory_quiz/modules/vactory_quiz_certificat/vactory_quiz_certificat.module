<?php

/**
 * @file
 * Module related hooks.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Site\Settings;
use Drupal\file\FileInterface;

/**
 * Implements hook_theme().
 */
function vactory_quiz_certificat_theme($existing, $type, $theme, $path) {
  return [
    'vactory_quiz_certificat_generate' => [
      'template' => 'quiz-certificat-generate',
      'variables' => [
        'content' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_file_download().
 *
 * Certificates are generated in "private://quiz_certificat": a user downloads
 * the certificates recorded for that user in the quiz history. A user with
 * the "administer site configuration" permission, the one of the settings
 * forms of the quiz modules, downloads any of them (support).
 *
 * Any other request for a file of the folder is refused (-1): the folder
 * belongs to this module, and no other implementation of the hook can grant
 * the download. The request is then answered "not found", as for a file that
 * does not exist (see
 * \Drupal\vactory_quiz_certificat\EventSubscriber\CertificatNotFoundSubscriber).
 *
 * A URI with a ".." segment, or another path to a file of the folder (a
 * link), is refused for everybody: the link to a certificate has none.
 *
 * Returns NULL for the other private files: this module has nothing to say.
 *
 * @see \Drupal\vactory_quiz_certificat\Services\CertificatAccess
 * @see vactory_quiz_certificat_file_access()
 */
function vactory_quiz_certificat_file_download($uri) {
  /** @var \Drupal\vactory_quiz_certificat\Services\CertificatAccess $access */
  $access = \Drupal::service('vactory_quiz_certificat.access');
  if (!$access->concerns($uri)) {
    return NULL;
  }
  if (!$access->isGranted($uri, \Drupal::currentUser())) {
    return -1;
  }
  return [
    'Content-Type' => 'application/pdf',
    'Cache-Control' => 'private',
  ];
}

/**
 * Implements hook_ENTITY_TYPE_access() for file entities.
 *
 * A module that manages files decides the download of a private file by the
 * access to its file entity, stored or built for the request (File Entity
 * does both, with its own file permissions). For a file of the folder of the
 * certificates, the decision is the one of this module: allowed for the owner
 * of the certificate and for the "administer site configuration" permission,
 * forbidden for any other account, whatever its file permissions.
 *
 * Only viewing and downloading are decided here. Other files are not
 * concerned.
 *
 * @see \Drupal\vactory_quiz_certificat\Services\CertificatAccess
 * @see vactory_quiz_certificat_file_download()
 */
function vactory_quiz_certificat_file_access(FileInterface $file, $operation, AccountInterface $account) {
  /** @var \Drupal\vactory_quiz_certificat\Services\CertificatAccess $access */
  $access = \Drupal::service('vactory_quiz_certificat.access');
  $uri = (string) $file->getFileUri();
  $operations = ['view', 'download'];
  if (!in_array($operation, $operations, TRUE) || !$access->concerns($uri)) {
    return AccessResult::neutral();
  }
  // Depends on the account and on its quiz history, which has no cache tag.
  $result = $access->isGranted($uri, $account) ? AccessResult::allowed() : AccessResult::forbidden();
  return $result->cachePerUser()->setCacheMaxAge(0);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function vactory_quiz_certificat_form_node_vactory_quiz_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['field_certificat_require']['#states'] = [
    'visible' => [
      'input[name="field_enable_certificat[value]"]' => ['checked' => TRUE],
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function vactory_quiz_certificat_mail($key, &$message, $params) {
  switch ($key) {
    case 'quiz_certificate_mail':
      $language_manager = Drupal::languageManager();
      $default_langcode = $language_manager->getDefaultLanguage()->getId();
      $langcode = Drupal::languageManager()->getCurrentLanguage()->getId();
      // Get module settings translation.
      $config = Drupal::config('vactory_quiz_certificat.settings');
      // For default language we use default config.
      $config_translation = $config;
      if ($langcode !== $default_langcode) {
        $config_translation = $language_manager->getLanguageConfigOverride($langcode, 'vactory_quiz_certificat.settings');
        if (empty($config_translation->get('certificat_body'))) {
          $config_translation = $config;
        }
      }
      if (empty($config_translation)) {
        $config_translation = $config;
      }
      $config = Drupal::config('vactory_quiz_certificat.settings');
      $subject = !empty($config_translation->get('email_subject')) ? $config_translation->get('email_subject') : $config->get('email_subject');
      $body = !empty($config_translation->get('email_body')) ? $config_translation->get('email_body') : $config->get('email_body');
      $body = !empty($body) ? $body['value'] : '';
      if (!empty($subject) && !empty($body)) {
        $subject = Drupal::token()->replace($subject, $params['tokens']);
        $body = Drupal::token()->replace($body, $params['tokens']);
        if (strpos($body, '://default/') !== FALSE) {
          $site_domain = Settings::get('site_domain');
          $body = str_replace('://default/', '://' . $site_domain . '/', $body);
        }
        $message['subject'] = $subject;
        $message['body'][] = $body;
      }
      break;
  }
}
