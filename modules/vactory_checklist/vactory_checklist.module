<?php

/**
 * @file
 * Primary module hooks for Vactory Checklist module.
 *
 * Slack cron: set $settings['vactory_checklist_slack_webhook'] to your Slack
 * Incoming Webhook URL (https://api.slack.com/messaging/webhooks).
 */

/**
 * Implements hook_cron().
 */
function vactory_checklist_cron() {
  \Drupal::service('vactory_checklist.slack_cron')->execute();
}

/**
 * Implements hook_theme().
 */
function vactory_checklist_theme() {
  return [
    'checklist_dashboard' => [
      'variables' => [
        'results' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_library_info_build().
 */
function vactory_checklist_library_info_build() {
  $libraries = [];
  $libraries['dashboard'] = [
    'css' => [
      'theme' => [
        'css/checklist.css' => [],
      ],
    ],
  ];
  return $libraries;
}
