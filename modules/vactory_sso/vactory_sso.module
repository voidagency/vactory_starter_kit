<?php

/**
 * @file
 * The current module customize oauth_login_oauth2 contrib module.
 */

use Drupal\user\UserInterface;
use Drupal\user\Entity\User;

/**
 * Implements hook_user_login().
 */
function vactory_sso_user_login(UserInterface $account) {
  $route_name = Drupal::routeMatch()->getRouteName();
  // Check if it's a user from Keycloak IDP then update fields.
  if ($route_name == 'oauth_login_oauth2.mo_login' && !empty($_SESSION['resource_owner'])) {
    $user = User::load($account->id());
    $config = Drupal::config('vactory_sso.settings');
    // Get the ressource owner to access keycloak user data.
    $resourceOwner = $_SESSION['resource_owner'];
    for ($i = 0; $i < $config->get('max_attr_count'); $i++) {
      $user_field_name = $config->get('vactory_sso_drupal_user_attr_' . ($i + 1));
      $keycloak_attr_name = $config->get('vactory_sso_keycloak_user_attr_' . ($i + 1));
      // Only fields which are mapped in vactory_sso settings page
      // will be updated.
      if (!empty($user_field_name) && !empty($keycloak_attr_name)) {
        $keycloak_attr_value = _vactory_sso_get_nested_attribute($resourceOwner, $keycloak_attr_name);
        $user->set($user_field_name, $keycloak_attr_value);
      }
    }
    $user->save();
  }
}

/**
 * Gets a resource owner attribute from a dot separated path (e.g. "a.b").
 *
 * When the attribute is a list, its first item is returned.
 */
function _vactory_sso_get_nested_attribute($resource, $key) {
  if (empty($key) || !is_array($resource)) {
    return '';
  }
  [$current_key, $rest] = array_pad(explode('.', $key, 2), 2, NULL);
  if (!isset($resource[$current_key])) {
    return '';
  }
  if ($rest !== NULL) {
    return _vactory_sso_get_nested_attribute($resource[$current_key], $rest);
  }
  return is_array($resource[$current_key]) ? ($resource[$current_key][0] ?? '') : $resource[$current_key];
}
