<?php

/**
 * @file
 * Module related install hooks.
 */

/**
 * Implements hook_schema().
 */
function vactory_dynamic_field_schema() {
  $schema['content_progress'] = vactory_df_get_table_schema();
  return $schema;
}

/**
 * Implements hook_update_N().
 */
function vactory_dynamic_field_update_9500(&$sandbox) {
  $schema = Drupal::database()->schema();
  // Only create the table if it doesn't already exist.
  if (!$schema->tableExists('content_progress')) {
    $schema->createTable('content_progress', vactory_df_get_table_schema());
  }

  // Enable paragraph_edit module when necessary.
  if (!Drupal::moduleHandler()->moduleExists('paragraphs_edit')) {
    \Drupal::service('module_installer')->install(['paragraphs_edit']);
  }
}

/**
 * Enable paragraphs_edit, a declared dependency of the module.
 *
 * Update 9500 was meant to enable it but its condition was inverted: sites
 * updated through it may not have the module.
 */
function vactory_dynamic_field_update_9501() {
  if (!\Drupal::moduleHandler()->moduleExists('paragraphs_edit')) {
    \Drupal::service('module_installer')->install(['paragraphs_edit']);
    return t('paragraphs_edit has been enabled.');
  }
}

/**
 * Record the files inserted in the editors of existing Dynamic Fields.
 *
 * Images uploaded from CKEditor in a Dynamic Field were left as temporary
 * files without usage: they are made permanent and their usage is recorded.
 */
function vactory_dynamic_field_update_9502(&$sandbox) {
  $recorded = \Drupal::service('vactory_dynamic_field.inline_file_usage')->recordExistingContent($sandbox);
  if ($sandbox['#finished'] >= 1) {
    return t('@count file usages recorded for Dynamic Fields.', ['@count' => $recorded]);
  }
}

/**
 * Content progress custom table schema.
 */
function vactory_df_get_table_schema() {
  return [
    'description' => 'Store content progress information',
    'fields' => [
      'id' => [
        'description' => 'Primary identifier',
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'entity_id' => [
        'description' => 'Related entity id',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'description' => 'Related entity type',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'paragraph_id' => [
        'description' => 'Related paragraph id',
        'type' => 'varchar',
        'length' => 255,
      ],
      'widget_id' => [
        'description' => 'Template widget id',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'widget_name' => [
        'description' => 'Template widget name',
        'type' => 'varchar',
        'length' => 255,
      ],
      'widget_screen' => [
        'description' => 'Template widget screen',
        'type' => 'varchar',
        'length' => 255,
      ],
      'field_name' => [
        'description' => 'Field name',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'langcode' => [
        'description' => 'Langcode',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'field_label' => [
        'description' => 'Field Label',
        'type' => 'varchar',
        'length' => 255,
      ],
      'pending' => [
        'description' => 'Indicate either the current field content is pending or not',
        'type' => 'int',
        'length' => 10,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
  ];
}
