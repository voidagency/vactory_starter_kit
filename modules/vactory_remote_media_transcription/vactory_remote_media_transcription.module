<?php

/**
 * @file
 * Primary module hooks for Vactory Remote Media Transcription module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\media\MediaInterface;

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function vactory_remote_media_transcription_field_widget_single_element_form_alter(&$element, FormStateInterface $form_state, array $context) {
  $plugin_id = $context['widget']->getPluginId();
  if ($plugin_id == 'media_library_widget') {
    $field_definition = $context['items']->getFieldDefinition();
    $media_field_type = _vactory_remote_media_transcription_get_media_field_type($field_definition);
    $media_ids = $context['items']->getValue();
    if ($media_field_type === 'remote_video') {

      // Get the media entity if it exists.
      $media = NULL;
      if (!empty($media_ids[0]['target_id'])) {
        $mid = $media_ids[0]['target_id'];
        $form_state->set(['vactory_remote_media_transcription', 'media_id'], $mid);
        $media = \Drupal::entityTypeManager()->getStorage('media')->load($mid);

        $element['transcription_wrapper'] = [
          '#type' => 'details',
          '#title' => t('Video Transcription'),
          '#open' => FALSE,
          '#weight' => 10,
        ];

        // Get default value from media entity if it exists.
        $default_value = '';
        $default_format = 'full_html';
        if ($media instanceof MediaInterface && $media->hasField('field_transcription')) {
          if (!$media->get('field_transcription')->isEmpty()) {
            $default_value = $media->get('field_transcription')->value;
            $default_format = $media->get('field_transcription')->format;
          }
        }

        $element['transcription_wrapper']['transcription'] = [
          '#type' => 'text_format',
          '#title' => t('Transcription textuelle'),
          '#format' => $default_format,
          '#default_value' => $default_value,
          '#element_validate' => [
            'vactory_remote_media_transcription_transcription_validate',
          ],
        ];
      }
    }
  }
}

/**
 * Custom validation function for the transcription field.
 */
function vactory_remote_media_transcription_transcription_validate(&$element, FormStateInterface $form_state, &$complete_form) {
  // Get the full user input data.
  $user_input = $form_state->getUserInput();

  // Ensure the components array exists.
  if (isset($user_input['components']) && is_array($user_input['components'])) {
    foreach ($user_input['components'] as $component) {
      // Check if video_transcription exists in the component.
      if (isset($component['video_transcription']) && is_array($component['video_transcription'])) {
        foreach ($component['video_transcription'] as $key => $transcription_data) {
          if (isset($transcription_data['transcription_wrapper']['transcription']['value'])) {
            $transcription_value = $transcription_data['transcription_wrapper']
              ['transcription']['value'];
            // Save to the media entity.
            $mid = $form_state->get(['vactory_remote_media_transcription', 'media_id']);
            if ($mid) {
              $media = \Drupal::entityTypeManager()->getStorage('media')->load($mid);
              if ($media instanceof MediaInterface && $media->hasField('field_transcription') && !empty($transcription_value)) {
                $media->set('field_transcription', [
                  'value' => $transcription_value,
                  'format' => 'full_html',
                ]);
                $media->save();
              }
            }
            return;
          }
        }
      }
    }
  }

  // If no transcription data was found.
  \Drupal::logger('Validate')->warning('No transcription data found.');
}

/**
 * Helper function to get media field type.
 */
function _vactory_remote_media_transcription_get_media_field_type(FieldDefinitionInterface $field_definition) {
  $field_settings = $field_definition->getSettings();
  if (!empty($field_settings['handler_settings']['target_bundles'])) {
    $target_bundles = array_values($field_settings['handler_settings']['target_bundles']);
    if (!empty($target_bundles)) {
      return reset($target_bundles);
    }
  }
  return NULL;
} 

/**
 * Implements hook_media_presave().
 */
function vactory_remote_media_transcription_media_presave(Drupal\media\MediaInterface $media) {
  if ($media->bundle() === 'remote_video' && $media->hasField('field_transcription')) {
    // Check if the transcription field needs to be updated.
    if ($transcription = \Drupal::request()->request->get('transcription')) {
      $media->set('field_transcription', $transcription);
    }
  }
}
