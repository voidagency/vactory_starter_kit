<?php

/**
 * @file
 * Install, update and uninstall functions for vactory_decoupled.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\link\LinkItemInterface;
use Drupal\simple_oauth\Plugin\Oauth2GrantManager;

/**
 * Implements hook_install().
 */
function vactory_decoupled_install() {
  _vactory_decoupled_enable_oauth_password_grant();
}

/**
 * Enables the password grant (and kit custom grants) on oauth consumers.
 *
 * Since simple_oauth 6.x grant types are enabled per consumer and per scope.
 */
function _vactory_decoupled_enable_oauth_password_grant() {
  $available_grants = array_keys(Oauth2GrantManager::getAvailablePluginsAsOptions());
  $grants = array_intersect(['password', 'refresh_token', 'faceid', 'apikey'], $available_grants);

  /** @var \Drupal\consumers\Entity\ConsumerInterface $consumer */
  foreach (\Drupal::entityTypeManager()->getStorage('consumer')->loadMultiple() as $consumer) {
    $consumer_grants = array_column($consumer->get('grant_types')->getValue(), 'value');
    $missing = array_diff($grants, $consumer_grants);
    if (!empty($missing)) {
      $consumer->set('grant_types', array_values(array_merge($consumer_grants, $missing)));
      $consumer->save();
    }
  }

  // Allow requesting role scopes with the password grant.
  /** @var \Drupal\simple_oauth\Entity\Oauth2ScopeEntityInterface $scope */
  foreach (\Drupal::entityTypeManager()->getStorage('oauth2_scope')->loadMultiple() as $scope) {
    $grant_types = $scope->get('grant_types') ?? [];
    if (in_array('password', $available_grants) && empty($grant_types['password']['status'])) {
      $grant_types['password'] = ['status' => TRUE];
      $scope->set('grant_types', $grant_types);
      $scope->save();
    }
  }
}

/**
 * Add node_settings field.
 */
function vactory_decoupled_update_9001() {
  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Node Settings'))
    ->setDescription(t('Add extra parameters in JSON Format : { "isHomePage": true, "taxonomy": 4, "limit": 6 }'))
    ->setRevisionable(TRUE)
    ->setTranslatable(TRUE)
    ->setDefaultValue('')
    ->setRequired(TRUE)
    ->setDisplayOptions('form', [
      'type'     => 'string_textarea',
      'weight'   => 1,
      'settings' => [
        'rows' => 4,
      ],
    ])
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('node_settings', 'node', 'node', $storage_definition);
}

