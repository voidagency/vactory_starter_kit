/**
 * Implements hook_update_dependencies().
 */
function vactory_decoupled_update_dependencies() {
  // Legacy token scopes must be replaced before simple_oauth migrates them.
  $dependencies['simple_oauth'][8605] = [
    'vactory_decoupled' => 10202,
  ];
  return $dependencies;
}

/**
 * Replace simple_oauth 5.x token scopes field before simple_oauth 6.x update.
 *
 * simple_oauth_update_8605() renames the legacy column before uninstalling
 * the legacy field, which fails on sites having tokens. Existing tokens are
 * deleted by simple_oauth_update_8605() anyway.
 */
function vactory_decoupled_update_10202() {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = $manager->getFieldStorageDefinition('scopes', 'oauth2_token');
  if (!$definition || $definition->getType() !== 'entity_reference') {
    return;
  }

  $database = \Drupal::database();
  if ($database->schema()->tableExists('oauth2_token__scopes')) {
    $database->truncate('oauth2_token__scopes')->execute();
  }
  $manager->uninstallFieldStorageDefinition($definition);

  $definition = BaseFieldDefinition::create('oauth2_scope_reference')
    ->setLabel(t('Scopes'))
    ->setDescription(t('The scopes for this Access Token.'))
    ->setRevisionable(TRUE)
    ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
    ->setTranslatable(FALSE);
  $manager->installFieldStorageDefinition('scopes', 'oauth2_token', 'simple_oauth', $definition);
}
