<?php

/**
 * @file
 * Primary module hooks for vactory_decoupled_espace_prive module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;
use Drupal\user_registrationpassword\UserRegistrationPassword;
use Drupal\webform\Entity\Webform;

/**
 * Account fields that must never be set from webform input.
 *
 * These are privilege / identity fields. Accepting them from the request body
 * enables mass-assignment: privilege escalation (roles[]=administrator,
 * status=1) and account takeover (uid, init, ...). This denylist is the
 * security boundary; it always wins, even if a site adds an element with one
 * of these keys to a webform.
 */
const VACTORY_ESPACE_PRIVE_FORBIDDEN_USER_FIELDS = [
  'uid',
  'roles',
  'status',
  'access',
  'login',
  'init',
  'created',
  'changed',
  'uuid',
  'langcode',
  'preferred_langcode',
  'preferred_admin_langcode',
  'default_langcode',
];

/**
 * Restricts submitted data to the fields the given webform actually declares.
 *
 * Prevents mass-assignment while still supporting per-project custom fields:
 * the allowlist is built from the webform's own elements (so any field a site
 * adds to the form flows through automatically), plus any explicit extra keys,
 * minus the forbidden account fields which are stripped unconditionally.
 *
 * @param array $webform_data
 *   The raw submitted data (request body).
 * @param string $webform_id
 *   The webform whose elements define the allowed keys.
 * @param array $extra
 *   Extra account keys to allow that are not webform element keys (e.g. the
 *   registration form keys its auth elements "email"/"password" but submits
 *   them as the user entity "mail"/"pass").
 *
 * @return array
 *   The filtered data, safe to pass to a user entity.
 */
function _vactory_decoupled_espace_prive_filter_user_data(array $webform_data, string $webform_id, array $extra = []) {
  $webform = Webform::load($webform_id);
  $allowed = $webform instanceof Webform
    ? array_keys($webform->getElementsInitializedFlattenedAndHasValue())
    : [];
  $allowed = array_merge($allowed, $extra);
  // The denylist always wins over the webform-derived allowlist.
  $allowed = array_diff($allowed, VACTORY_ESPACE_PRIVE_FORBIDDEN_USER_FIELDS);
  return array_intersect_key($webform_data, array_flip($allowed));
}

/**
 * Implements hook_decoupled_webform_data_presubmit_alters().
 */
function vactory_decoupled_espace_prive_decoupled_webform_data_presubmit_alter(array &$webform_data, &$error_message) {
  if (isset($webform_data['webform_id']) && $webform_data['webform_id'] === 'vactory_espace_prive_register') {
    $existing_user = user_load_by_mail($webform_data['mail']);

    if ($existing_user instanceof UserInterface) {
      $error_message = [
        'error' => [
          'message' => t("The mail is already in existence, try another one"),
        ],
      ];
      return;
    }

    // Only accept fields declared on the registration webform. This blocks
    // mass-assignment of privilege/identity fields such as roles[], status,
    // uid, etc. from the request body.
    $user_data = _vactory_decoupled_espace_prive_filter_user_data($webform_data, 'vactory_espace_prive_register', ['mail', 'pass']);

    // New accounts are always blocked until the approval logic below decides
    // otherwise; never trust a submitted status.
    $user_data['status'] = 0;

    // Get username by mail.
    $new_name = preg_replace('/@.*$/', '', $user_data['mail']);
    $new_name = email_registration_cleanup_username($new_name);
    $user_data['name'] = email_registration_unique_username($new_name);

    $userSettings = \Drupal::configFactory()->get('user.settings');
    $approval_settings = $userSettings->get('register');
    $user_registrationpassword_type = \Drupal::configFactory()
      ->getEditable('user_registrationpassword.settings')
      ->get('registration') ?? [];

    if ($approval_settings === UserInterface::REGISTER_VISITORS &&
      ($user_registrationpassword_type == UserRegistrationPassword::NO_VERIFICATION ||
        $user_registrationpassword_type == UserRegistrationPassword::VERIFICATION_DEFAULT)) {
      $user_data['status'] = 1;
    }

    try {
      $account = User::create($user_data);
      $account->save();
    }
    catch (\Exception $exception) {
      $error_message = [
        'error' => [
          'message' => t("Une erreur s'est produite"),
        ],
      ];
      return;
    }

    if ($approval_settings === UserInterface::REGISTER_VISITORS) {
      switch ($user_registrationpassword_type) {
        case UserRegistrationPassword::NO_VERIFICATION:
          _user_mail_notify('register_no_approval_required', $account);
          break;

        case UserRegistrationPassword::VERIFICATION_DEFAULT:
          _user_mail_notify('register_no_approval_required', $account);
          break;

        case UserRegistrationPassword::VERIFICATION_PASS:
          _user_registrationpassword_mail_notify('register_confirmation_with_pass', $account);
          break;
      }
    }
    // Administrator approval required.
    elseif ($approval_settings === UserInterface::REGISTER_VISITORS_ADMINISTRATIVE_APPROVAL) {
      _user_mail_notify('register_pending_approval', $account);
    }

  }

  if (isset($webform_data['webform_id']) && $webform_data['webform_id'] === 'vactory_espace_prive_edit') {
    $current_user_id = \Drupal::service('current_user')->getAccount()->id();
    $user = !empty($current_user_id) ? User::load($current_user_id) : NULL;

    if (!$user instanceof UserInterface) {
      $error_message = [
        'error' => [
          'message' => t("Invalid User"),
        ],
      ];
      return;
    }

    // Only accept fields declared on the edit webform. This blocks a logged-in
    // user from escalating their own account (e.g. roles[]=administrator,
    // status=1) or overwriting identity fields via the request body.
    $user_data = _vactory_decoupled_espace_prive_filter_user_data($webform_data, 'vactory_espace_prive_edit');

    foreach ($user_data as $field => $value) {
      $user->set($field, $value);
    }
    try {
      $user->save();
    }
    catch (\Exception $exception) {
      $error_message = [
        'error' => [
          'message' => t("Une erreur s'est produite:") . $exception->getMessage(),
        ],
      ];
    }
  }

}

/**
 * Implements hook_df_jsonapi_output_alter().
 */
function vactory_decoupled_espace_prive_df_jsonapi_output_alter(&$content) {
  if (isset($content['components'][0]['id'])) {
    $key = $content['components'][0]['id'];
    if ($key == 'vactory_decoupled_singup') {
      $config = \Drupal::config('user_registrationpassword.settings');
      $content['components'][0]['singup_config'] = [
        'user_registration_password' => $config->get('registration') ?? 'with-pass',
      ];
    }
  }
}

/**
 * Implements hook_decoupled_df_format_alter().
 */
function vactory_decoupled_espace_prive_decoupled_df_format_alter(&$value, &$info, &$cacheability) {
  if ($info['uuid'] == 'vactory_decoupled_espace_prive:signup') {
    $cacheTags = Cache::mergeTags($cacheability->getCacheTags(), ['config:user_registrationpassword.settings']);
    $cacheability->setCacheTags($cacheTags);
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function vactory_decoupled_espace_prive_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() == 'user') {
    $fields['pass']->addConstraint('VactoryPasswordPolicyConstraint');
  }
}
