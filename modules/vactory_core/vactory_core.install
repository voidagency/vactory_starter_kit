<?php

/**
 * @file
 * Install, update and requirements functions for vactory_core.
 */

/**
 * Implements hook_requirements().
 */
function vactory_core_requirements($phase) {
  $requirements = [];
  if ($phase !== 'runtime' || !\Drupal::moduleHandler()->moduleExists('shield')) {
    return $requirements;
  }
  $shield = \Drupal::config('shield.settings');
  if ($shield->get('shield_enable') && $shield->get('credential_provider') === 'shield') {
    $user = (string) $shield->get('credentials.shield.user');
    $pass = (string) $shield->get('credentials.shield.pass');
    if (trim($user) === '' || trim($pass) === '') {
      $requirements['vactory_core_shield_credentials'] = [
        'title' => t('Shield credentials'),
        'value' => t('Empty user or password'),
        'description' => t('Shield is enabled without Basic Auth credentials: anyone can log in with an empty user and password. Set them in the Shield settings.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Captcha: empty the default wrong answer message so that it is translated.
 */
function vactory_core_update_10001() {
  if (!\Drupal::moduleHandler()->moduleExists('captcha')) {
    return t('Captcha is not installed: nothing to do.');
  }
  $config = \Drupal::configFactory()->getEditable('captcha.settings');
  $message = trim((string) $config->get('wrong_captcha_response_message'));
  if ($config->isNew() || $message === '') {
    return t('Captcha wrong answer message already empty: nothing to do.');
  }
  if (!in_array($message, _vactory_core_captcha_default_error_messages(), TRUE)) {
    return t('Captcha wrong answer message is customised and was kept: "@message". It is now displayed as is; translate it with the configuration translation, or empty it to use the translated default message.', ['@message' => $message]);
  }
  $config->set('wrong_captcha_response_message', '')->save();
  return t('Captcha wrong answer message emptied: the default message is used, translated by the interface translation.');
}
